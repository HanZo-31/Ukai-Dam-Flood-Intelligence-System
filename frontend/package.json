    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "geotiff": "3.1.0-beta.0",
    "lucide-react": "^0.544.0",
    "ol": "^10.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
