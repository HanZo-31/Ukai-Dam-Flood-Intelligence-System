{
  "name": "ukai-flood-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Ukai Flood Explorer: local, read-only frontend for the four stored Ukai flood simulations (uncalibrated prototype).",
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
